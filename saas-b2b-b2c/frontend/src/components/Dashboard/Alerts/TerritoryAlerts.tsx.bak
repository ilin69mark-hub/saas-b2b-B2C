// src/components/Dashboard/Alerts/TerritoryAlerts.tsx
import React, { useMemo } from 'react';
import { Badge, Popover, List, Tag, Space, Button, Input, Select, Typography, Empty, Tooltip, Divider, Switch, Checkbox, Card, Row, Col, InputNumber } from 'antd';
import { BellOutlined, WarningOutlined, ShopOutlined, FileTextOutlined, UserOutlined, ArrowRightOutlined, CheckOutlined, SettingOutlined, DeleteOutlined, DollarOutlined, PercentageOutlined, ClockCircleOutlined, ExclamationCircleOutlined, MailOutlined, GlobalOutlined } from '@ant-design/icons';
import dayjs from 'dayjs';
import relativeTime from 'dayjs/plugin/relativeTime';
import { useAlertStore, Alert, AlertCategory, AlertSettings } from '@/store/alertStore';

dayjs.extend(relativeTime);

const { Text } = Typography;

interface TerritoryAlertsProps {
  placement?: 'left' | 'right';
  userName?: string;
}

const CATEGORY_CONFIG = {
  plan: { label: 'План и продажи', icon: <PercentageOutlined />, color: '#ff4d4f' },
  funnel: { label: 'Воронка и конверсия', icon: <FileTextOutlined />, color: '#fa8c16' },
  stock: { label: 'Склад и товар', icon: <ShopOutlined />, color: '#722ed1' },
  communications: { label: 'Коммуникации', icon: <UserOutlined />, color: '#1890ff' },
  activity: { label: 'Активность дилеров', icon: <ClockCircleOutlined />, color: '#52c41a' },
};

const TerritoryAlerts: React.FC<TerritoryAlertsProps> = ({ userName }) => {
  const { 
    alerts, 
    settings, 
    filter, 
    setFilter, 
    markAsRead, 
    markAllAsRead,
    getUnreadCount 
  } = useAlertStore();

  const unreadCount = getUnreadCount();

  const currentAlerts = useMemo(() => {
    let filtered = alerts;
    if (filter === 'critical') {
      filtered = filtered.filter(a => a.priority === 'critical');
    } else if (filter !== 'all') {
      filtered = filtered.filter(a => a.category === filter);
    }
    return filtered.sort((a, b) => dayjs(b.createdAt).unix() - dayjs(a.createdAt).unix());
  }, [alerts, filter]);

  const groupedAlerts = useMemo(() => {
    const groups: Record<AlertCategory, Alert[]> = {
      plan: [], funnel: [], stock: [], communications: [], activity: []
    };
    currentAlerts.forEach(a => groups[a.category].push(a));
    return groups;
  }, [currentAlerts]);

  const handleMarkAsRead = (alertId: string, e: React.MouseEvent) => {
    e.stopPropagation();
    markAsRead(alertId);
  };

  const handleMarkAllAsRead = () => {
    markAllAsRead();
  };

  return (
    <Popover
      content={
        <div style={{ width: 400, maxHeight: 500, overflow: 'auto' }}>
          <div style={{ padding: '8px 0', borderBottom: '1px solid #f0f0f0', marginBottom: 8 }}>
            <Space style={{ width: '100%', justifyContent: 'space-between' }}>
              <Text strong>Алерты</Text>
              {unreadCount > 0 && <Tag color="red">{unreadCount} новых</Tag>}
            </Space>
          </div>

          <div style={{ marginBottom: 12 }}>
            <Select 
              value={filter} 
              onChange={setFilter} 
              style={{ width: '100%' }}
              options={[
                { label: 'Все', value: 'all' },
                { label: 'Только критические', value: 'critical' },
                { label: 'План и продажи', value: 'plan' },
                { label: 'Воронка', value: 'funnel' },
                { label: 'Склад', value: 'stock' },
                { label: 'Коммуникации', value: 'communications' },
                { label: 'Активность', value: 'activity' },
              ]}
            />
          </div>

          {currentAlerts.length === 0 ? (
            <Empty description="Нет алертов" />
          ) : (
            <>
              {Object.entries(groupedAlerts).map(([category, items]) => {
                if (items.length === 0) return null;
                const config = CATEGORY_CONFIG[category as AlertCategory];
                return (
                  <div key={category}>
                    <Divider style={{ margin: '8px 0' }}>
                      <Space>
                        <span style={{ color: config.color }}>{config.icon}</span>
                        <Text type="secondary">{config.label}</Text>
                        <Tag color="default">{items.length}</Tag>
                      </Space>
                    </Divider>
                    <List
                      size="small"
                      dataSource={items}
                      renderItem={(item) => (
                        <List.Item
                          style={{ 
                            background: item.status === 'new' ? '#fff7e6' : 'transparent',
                            padding: '8px 12px',
                            margin: '0 -12px',
                          }}
                          actions={[
                            <Tooltip key="goto" title="Перейти">
                              <Button 
                                type="text" 
                                size="small" 
                                icon={<ArrowRightOutlined />}
                                href={item.deepLink}
                              />
                            </Tooltip>,
                            <Tooltip key="read" title="Отметить прочитанным">
                              <Button 
                                type="text" 
                                size="small" 
                                icon={<CheckOutlined />}
                                onClick={(e) => handleMarkAsRead(item.id, e)}
                              />
                            </Tooltip>,
                          ]}
                        >
                          <List.Item.Meta
                            title={
                              <Space>
                                <Text strong={item.status === 'new'}>{item.title}</Text>
                                {item.priority === 'critical' && (
                                  <WarningOutlined style={{ color: '#ff4d4f' }} />
                                )}
                                {item.dealerName && <Tag>{item.dealerName}</Tag>}
                              </Space>
                            }
                            description={
                              <Space direction="vertical" size={0}>
                                <Text type="secondary" style={{ fontSize: 12 }}>{item.description}</Text>
                                {item.details && (
                                  <Text type="secondary" style={{ fontSize: 11 }}>{item.details}</Text>
                                )}
                                <Text type="secondary" style={{ fontSize: 11 }}>
                                  {dayjs(item.createdAt).fromNow()}
                                </Text>
                              </Space>
                            }
                          />
                        </List.Item>
                      )}
                    />
                  </div>
                );
              })}
            </>
          )}

          {unreadCount > 0 && (
            <Divider style={{ margin: '12px 0' }} />
          )}

          <div style={{ textAlign: 'center' }}>
            {unreadCount > 0 && (
              <Button type="link" onClick={handleMarkAllAsRead}>
                Отметить все прочитанными
              </Button>
            )}
          </div>
        </div>
      }
      trigger="click"
      placement={placement || 'bottomRight'}
    >
      <Badge count={unreadCount} offset={[-5, 5]}>
        <Button 
          type="text" 
          icon={<BellOutlined style={{ fontSize: 20 }} />}
          style={{ fontSize: 18 }}
        />
      </Badge>
    </Popover>
  );
};

export default TerritoryAlerts;