import React from 'react';
import { Badge, Dropdown, Button, List, Tag, Space, Typography, Divider, Select, Empty } from 'antd';
import { 
  BellOutlined, 
  WarningFilled,
  WarningOutlined,
  CheckCircleOutlined,
  TeamOutlined,
  ShopOutlined,
  BarChartOutlined,
  ExclamationCircleOutlined,
  ClockCircleOutlined,
  RightOutlined,
} from '@ant-design/icons';
import { useFranchiserAlertStore, FranchiserAlert } from '@/store/franchiserAlertStore';
import dayjs from 'dayjs';
import relativeTime from 'dayjs/plugin/relativeTime';

dayjs.extend(relativeTime);

const { Text, Title } = Typography;

interface AlertDropdownProps {
  onNavigate?: (tab: string, id?: string) => void;
}

const getAlertIcon = (type: string) => {
  switch (type) {
    case 'plan': return <BarChartOutlined style={{ color: '#1890ff' }} />;
    case 'dealer': return <ShopOutlined style={{ color: '#52c41a' }} />;
    case 'manager': return <TeamOutlined style={{ color: '#722ed1' }} />;
    case 'escalation': return <ExclamationCircleOutlined style={{ color: '#ff4d4f' }} />;
    default: return <WarningOutlined />;
  }
};

const getSeverityBadge = (severity: string) => {
  return severity === 'critical' ? '🔴' : '🟡';
};

const AlertDropdown = ({ onNavigate }: any) => {
  const { 
    alerts, 
    filter, 
    setFilter, 
    markAsRead, 
    assignAlert, 
    resolveAlert,
    setOpen 
  } = useFranchiserAlertStore();

  const filteredAlerts = React.useMemo(() => {
    if (filter === 'all') return alerts.filter(a => a.status !== 'resolved');
    if (filter === 'critical') return alerts.filter(a => a.severity === 'critical' && a.status !== 'resolved');
    return alerts.filter(a => a.type === filter && a.status !== 'resolved');
  }, [alerts, filter]);

  const criticalAlerts = filteredAlerts.filter(a => a.severity === 'critical');
  const warningAlerts = filteredAlerts.filter(a => a.severity === 'warning');

  const renderAlertItem = (alert: FranchiserAlert) => (
    <List.Item
      key={alert.id}
      style={{ 
        padding: '12px 16px',
        background: alert.severity === 'critical' ? '#fff1f0' : '#fffbe6',
        borderLeft: alert.severity === 'critical' ? '3px solid #ff4d4f' : '3px solid #fa8c16',
        marginBottom: 8,
        borderRadius: 4,
      }}
      actions={[
        <Button 
          key="analyze" 
          size="small" 
          type="link"
          onClick={() => onNavigate?.('network')}
        >
          Анализировать <RightOutlined />
        </Button>,
      ]}
    >
      <List.Item.Meta
        avatar={getAlertIcon(alert.type)}
        title={
          <Space>
            <Text strong>{alert.title}</Text>
            {alert.severity === 'critical' && <Badge status="error" />}
          </Space>
        }
        description={
          <Space direction="vertical" size={0}>
            <Text type="secondary">{alert.description}</Text>
            <Space>
              <ClockCircleOutlined style={{ fontSize: 12 }} />
              <Text type="secondary" style={{ fontSize: 11 }}>
                {dayjs(alert.createdAt).fromNow()}
              </Text>
              {alert.assignedTo && (
                <Tag>{alert.assignedTo}</Tag>
              )}
            </Space>
            {alert.status !== 'resolved' && (
              <Space>
                <Button 
                  size="small" 
                  onClick={() => assignAlert(alert.id, 'Менеджер')}
                >
                  Назначить
                </Button>
                <Button 
                  size="small" 
                  type="primary"
                  onClick={() => resolveAlert(alert.id)}
                >
                  Закрыть
                </Button>
              </Space>
            )}
          </Space>
        }
      />
    </List.Item>
  );

  const dropdownContent = (
    <div style={{ width: 400, maxHeight: 500, overflow: 'auto', background: '#fff' }}>
      <div style={{ padding: '12px 16px', borderBottom: '1px solid #f0f0f0', display: 'flex', justifyContent: 'space-between', width: '100%' }}>
        <Title level={5} style={{ margin: 0 }}>Уведомления</Title>
        <Select 
              value={filter} 
              onChange={setFilter} 
              style={{ width: 140 }}
              size="small"
            >
              <Select.Option value="all">Все</Select.Option>
              <Select.Option value="critical">🔴 Критические</Select.Option>
              <Select.Option value="plan">План</Select.Option>
              <Select.Option value="dealer">Дилеры</Select.Option>
              <Select.Option value="manager">Менеджеры</Select.Option>
              <Select.Option value="escalation">Эскалации</Select.Option>
            </Select>
        </div>
      </div>

      {filteredAlerts.length === 0 && (
        <Empty description="Нет уведомлений" style={{ padding: 40 }} />
      )}

      {filteredAlerts.length > 0 && (
        <div style={{ padding: 8 }}>
          {criticalAlerts.length > 0 && (
            <>
              <Text type="danger" strong>🔴 Критические ({criticalAlerts.length})</Text>
              <List
                dataSource={criticalAlerts}
                renderItem={renderAlertItem}
                locale={{ emptyText: ' ' }}
              />
              <Divider style={{ margin: '8px 0' }} />
            </>
          )}

          {warningAlerts.length > 0 && (
            <>
              <Text type="warning" strong>🟡 Предупреждения ({warningAlerts.length})</Text>
              <List
                dataSource={warningAlerts}
                renderItem={renderAlertItem}
              />
            </>
          )}
        </div>
      )}
    </div>
  );

  const unreadCount = alerts.filter(a => a.status === 'new').length;
  const criticalCount = alerts.filter(a => a.severity === 'critical' && a.status !== 'resolved').length;

  return (
    <Dropdown 
      dropdownRender={() => dropdownContent}
      trigger={['click']}
      placement="bottomRight"
    >
      <Badge count={criticalCount} size="small" offset={[-2, 2]}>
        <Button 
          type="text" 
          icon={<BellOutlined style={{ fontSize: 18 }} />}
          style={{ display: 'flex', alignItems: 'center', justifyContent: 'center' }}
        />
      </Badge>
    </Dropdown>
  );
};

export default AlertDropdown;