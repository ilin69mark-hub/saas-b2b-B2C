{
  "compilerOptions": {
    /* --------------------------------------------------------------
       1️⃣ Целевая версия JavaScript.
       ESNext → использует новейший синтаксис, а Next.js сам будет
       транспилировать в то, что требуется текущим браузерам.
       -------------------------------------------------------------- */
    "target": "esnext",

    /* --------------------------------------------------------------
       2️⃣ Библиотеки, которые будут включены в типизацию.
       Добавляем «esnext», «dom» и «dom.iterable», чтобы был доступен
       Promise, Map, async/await, а также все DOM‑типы.
       -------------------------------------------------------------- */
    "lib": ["dom", "dom.iterable", "esnext"],

    /* --------------------------------------------------------------
       3️⃣ Общие настройки проекта.
       -------------------------------------------------------------- */
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",          // для Next.js 13+ (app‑router)
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,

    /* --------------------------------------------------------------
       4️⃣ Плагины (Next.js добавляет свои типы)
       -------------------------------------------------------------- */
    "plugins": [
      {
        "name": "next"
      }
    ],

    /* --------------------------------------------------------------
       5️⃣ Псевдонимы импортов (alias).  baseUrl = корень проекта.
       -------------------------------------------------------------- */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/types/*": ["./src/types/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/services/*": ["./src/services/*"],
      "@/store/*": ["./src/store/*"]
    },

    "forceConsistentCasingInFileNames": true
  },

  /* --------------------------------------------------------------
     6️⃣ Что компилятору нужно обрабатывать
     -------------------------------------------------------------- */
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],

  /* --------------------------------------------------------------
     7️⃣ Что исключаем
     -------------------------------------------------------------- */
  "exclude": ["node_modules"]
}
