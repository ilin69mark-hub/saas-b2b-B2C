# Multi-stage build for frontend
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./

RUN npm ci

COPY frontend/ .

RUN npm run build

# Development stage
FROM node:20-alpine AS development

WORKDIR /app

COPY frontend/package*.json ./

RUN npm install -g next@14

RUN npm ci

EXPOSE 3000

ENV NODE_ENV=development
ENV PORT=3000

CMD ["npm", "run", "dev"]