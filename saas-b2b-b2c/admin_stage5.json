    "item": [
        {
            "name": "1. Get Unit Economics",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/admin/economics",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "admin",
                        "economics"
                    ]
                },
                "description": "Получение расчетных значений LTV, CAC и их соотношения."
            },
            "response": [
                {
                    "name": "Success Response",
                    "originalRequest": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/admin/economics",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "admin",
                                "economics"
                            ]
                        }
                    },
                    "status": "OK",
                    "code": 200,
                    "_postman_previewlanguage": "json",
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": "{\n    \"ltv\": 45000.00,\n    \"cac\": 12000.50,\n    \"ltv_cac_ratio\": 3.75,\n    \"marketing_spend\": 50000.00,\n    \"new_tenants_month\": 4\n}"
                }
            ]
        },
        {
