{
    "info": {
        "_postman_id": "stage-2-analytics-ru",
        "name": "SaaS Этап 1 и 2: Полная проверка",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "0. Проверка здоровья (Health)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус OK', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.test('Память стабильна (< 500Мб)', () => pm.expect(json.memory_mb).to.be.below(500));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/../health",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "1. Вход (Супер Админ)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Вход успешен', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('token', json.token);",
                            "console.log('Токен сохранен:', json.token);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"admin@admin.ru\",\n    \"password\": \"qwerty\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/auth/login",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "2. Статистика Дашборда (Этап 1)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статистика доступна', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.test('Есть MRR', () => pm.expect(json).to.have.property('mrr'));",
                            "pm.test('Есть Активные Сети', () => pm.expect(json).to.have.property('active_tenants'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/admin/stats",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "3. Аналитика и Воронка (Этап 2 - НОВОЕ)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Эндпоинт аналитики работает', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "",
                            "// Проверка структуры данных",
                            "pm.test('Есть DAU', () => pm.expect(json).to.have.property('dau'));",
                            "pm.test('Есть MAU', () => pm.expect(json).to.have.property('mau'));",
                            "pm.test('Есть Sticky Factor', () => pm.expect(json).to.have.property('sticky_factor'));",
                            "",
                            "// Проверка воронки",
                            "pm.test('Есть данные воронки', () => pm.expect(json).to.have.property('funnel'));",
                            "pm.test('Есть конверсия в воронке', () => pm.expect(json.funnel).to.have.property('conversion'));",
                            "",
                            "console.log('DAU (активных сегодня):', json.dau);",
                            "console.log('Sticky Factor (липкость):', json.sticky_factor);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/admin/analytics",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "4. Создать Тариф",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Тариф создан', () => pm.response.to.have.status(201));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('plan_id', json.id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Тест Аналитика\",\n    \"price\": 5000,\n    \"max_users\": 10\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/admin/plans",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "5. Создать Сеть (Tenant)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Сеть создана', () => pm.response.to.have.status(201));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('tenant_id', json.id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Сеть для Аналитики\",\n    \"plan_id\": \"{{plan_id}}\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/admin/tenants",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "6. Удалить Сеть",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/admin/tenants/{{tenant_id}}",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "7. Удалить Тариф",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/admin/plans/{{plan_id}}",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8080/api/v1"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "plan_id",
            "value": ""
        },
        {
            "key": "tenant_id",
            "value": ""
        }
    ]
}