{
    "info": {
        "_postman_id": "stage-4-risks-health",
        "name": "SaaS Этап 4: Риски и Health Score",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "0. Health Check",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Сервер работает', () => pm.response.to.have.status(200));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/../health",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "1. Логин (Супер Админ)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Вход успешен', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('token', json.token);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"admin@admin.ru\",\n    \"password\": \"qwerty\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/auth/login",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "2. Создать Тариф",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Тариф создан', () => pm.response.to.have.status(201));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('plan_id', json.id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Тест Риск\",\n    \"price\": 100,\n    \"max_users\": 1\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/admin/plans",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "3. Создать Сеть (Без оплаты)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Сеть создана', () => pm.response.to.have.status(201));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('risk_tenant_id', json.id);",
                            "// Эта сеть создана без paid_until, должна попасть в риски'"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Проблемная Сеть\",\n    \"plan_id\": \"{{plan_id}}\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/admin/tenants",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "4. Проверить Риски (Должна быть новая сеть)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Эндпоинт рисков доступен', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "",
                            "pm.test('Массив рисков не пуст', () => pm.expect(json).to.be.an('array').that.is.not.empty);",
                            "",
                            "// Ищем нашу созданную сеть в списке рисков",
                            "const riskTenant = json.find(t => t.id === pm.collectionVariables.get('risk_tenant_id'));",
                            "",
                            "pm.test('Созданная сеть в списке рисков', () => pm.expect(riskTenant).to.exist);",
                            "",
                            "if (riskTenant) {",
                            "    pm.test('Health Score < 100', () => pm.expect(riskTenant.health_score).to.be.below(100));",
                            "    pm.test('Есть причина риска', () => pm.expect(riskTenant.risk_reason).to.include('Просрочена оплата'));",
                            "    console.log('Health Score:', riskTenant.health_score);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/admin/risks",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "5. Оплатить сеть (Исправить риск)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Сеть обновлена', () => pm.response.to.have.status(200));",
                            "// Устанавливаем paid_until на будущее"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Проблемная Сеть (Исправлена)\",\n    \"paid_until\": \"2026-12-31T00:00:00Z\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/admin/tenants/{{risk_tenant_id}}",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "6. Проверить Риски (Сеть должна исчезнуть)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Эндпоинт рисков доступен', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "",
                            "const riskTenant = json.find(t => t.id === pm.collectionVariables.get('risk_tenant_id'));",
                            "",
                            "// Если сеть все еще там (например, из-за отсутствия активности), проверим что счет вырос",
                            "if (riskTenant) {",
                            "    console.log('Сеть все еще в рисках, причина:', riskTenant.risk_reason);",
                            "    pm.test('Score вырос после оплаты', () => pm.expect(riskTenant.health_score).to.be.above(50));",
                            "} else {",
                            "    pm.test('Сеть исчезла из списка рисков', () => pm.expect(riskTenant).to.be.undefined);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/admin/risks",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8080/api/v1"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "plan_id",
            "value": ""
        },
        {
            "key": "risk_tenant_id",
            "value": ""
        }
    ]
}