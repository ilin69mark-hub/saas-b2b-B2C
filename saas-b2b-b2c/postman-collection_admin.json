{
    "info": {
        "_postman_id": "franchise-saas-super-admin-correct",
        "name": "Franchise SaaS (Super Admin — Full)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Авторизация",
            "item": [
                {
                    "name": "Вход (Супер-Админ)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                                    "if (jsonData.token) {",
                                    "    pm.collectionVariables.set(\"token\", jsonData.token);",
                                    "    pm.collectionVariables.set(\"tenant_id\", jsonData.user.tenant_id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@admin.com\",\n    \"password\": \"adminpassword\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/login",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "auth", "login"]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Админ-панель (База)",
            "item": [
                {
                    "name": "Статистика",
                    "request": {
                        "method": "GET",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/stats",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "stats"]
                        }
                    }
                },
                {
                    "name": "Список всех Тенантов",
                    "request": {
                        "method": "GET",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/tenants",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "tenants"]
                        }
                    }
                },
                {
                    "name": "Создать Тенанта",
                    "request": {
                        "method": "POST",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"New Company\",\n    \"plan_id\": \"{{plan_id}}\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/tenants",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "tenants"]
                        }
                    }
                },
                {
                    "name": "Создать План",
                    "event": [
                        {
                            "listen": "test",
                            "script": { "exec": [ "var jsonData = pm.response.json();", "if(jsonData.id) pm.collectionVariables.set(\"plan_id\", jsonData.id);" ], "type": "text/javascript" }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Enterprise\",\n    \"price\": 10000,\n    \"max_users\": 50\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/plans",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "plans"]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. Управление Тенантом (Карточка)",
            "item": [
                {
                    "name": "0. Получить ID Тенанта (Авто)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData && jsonData.length > 0) {",
                                    "    pm.collectionVariables.set(\"tenant_id\", jsonData[0].id);",
                                    "    console.log(\"ID сохранен: \" + jsonData[0].id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/tenants",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "tenants"]
                        }
                    }
                },
                {
                    "name": "Статус Подписки (Инфо)",
                    "request": {
                        "method": "GET",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/tenants/{{tenant_id}}",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "tenants", "{{tenant_id}}"]
                        }
                    }
                },
                {
                    "name": "Изменить Данные / Продлить",
                    "request": {
                        "method": "PUT",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Updated Company Name\",\n    \"paid_until\": \"2026-12-31T23:59:59Z\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/tenants/{{tenant_id}}",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "tenants", "{{tenant_id}}"]
                        }
                    }
                },
                {
                    "name": "Заблокировать Тенанта",
                    "request": {
                        "method": "PUT",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"status\": \"blocked\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/tenants/{{tenant_id}}",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "tenants", "{{tenant_id}}"]
                        }
                    }
                },
                {
                    "name": "Удалить Тенанта",
                    "request": {
                        "method": "DELETE",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/tenants/{{tenant_id}}",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "tenants", "{{tenant_id}}"]
                        }
                    }
                }
            ]
        },
        {
            "name": "4. Финансы",
            "item": [
                {
                    "name": "Статус Оплат (Список)",
                    "request": {
                        "method": "GET",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/tenants/payments",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "tenants", "payments"]
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        { "key": "base_url", "value": "http://localhost:8080" },
        { "key": "token", "value": "" },
        { "key": "tenant_id", "value": "" },
        { "key": "plan_id", "value": "" }
    ]
}