                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"amount\": 150000.00\n}"
                },
                "url": {
                    "raw": "{{base_url}}/admin/economics/marketing-spend",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "admin",
                        "economics",
                        "marketing-spend"
                    ]
                },
                "description": "Обновление бюджета на маркетинг за текущий месяц (влияет на расчет CAC)."
            },
            "response": [
                {
                    "name": "Success Update",
                    "originalRequest": {
                        "method": "POST",
                        "header": [],
