{
    "info": {
        "_postman_id": "stage-3-product-kpi",
        "name": "SaaS Этап 3: Продукт и KPI",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "0. Health Check",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Сервер работает', () => pm.response.to.have.status(200));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/../health",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "1. Логин (Супер Админ)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Вход успешен', () => pm.response.to.have.status(200));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('token', json.token);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"admin@admin.ru\",\n    \"password\": \"qwerty\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/auth/login",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "2. Продукт и KPI (Этап 3 - НОВОЕ)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Эндпоинт продуктовой аналитики доступен', () => pm.response.to.have.status(200));",
                            "",
                            "const json = pm.response.json();",
                            "",
                            "// 1. Проверка структуры KPI",
                            "pm.test('Есть блок KPI', () => pm.expect(json).to.have.property('kpi'));",
                            "pm.test('KPI содержит % выполнения', () => pm.expect(json.kpi).to.have.property('completion_rate'));",
                            "pm.test('KPI содержит кол-во задач', () => pm.expect(json.kpi).to.have.property('total_tasks'));",
                            "",
                            "// 2. Проверка Trials",
                            "pm.test('Есть блок Trials', () => pm.expect(json).to.have.property('trials'));",
                            "pm.test('Trials содержит active_count', () => pm.expect(json.trials).to.have.property('active_count'));",
                            "",
                            "// 3. Проверка Retention",
                            "pm.test('Есть блок Product', () => pm.expect(json).to.have.property('product'));",
                            "pm.test('Product содержит retention_rate', () => pm.expect(json.product).to.have.property('retention_rate'));",
                            "",
                            "console.log('KPI %:', json.kpi.completion_rate);",
                            "console.log('Retention %:', json.product.retention_rate);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/admin/product-analytics",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "3. Создать Тариф (для теста)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Тариф создан', () => pm.response.to.have.status(201));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('plan_id', json.id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Тест KPI\",\n    \"price\": 1000,\n    \"max_users\": 5\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/admin/plans",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "4. Создать Сеть (влияет на Retention)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Сеть создана', () => pm.response.to.have.status(201));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('tenant_id', json.id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Сеть для KPI\",\n    \"plan_id\": \"{{plan_id}}\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/admin/tenants",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "5. Создать Чек-лист (влияет на KPI)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Чек-лист создан', () => pm.response.to.have.status(201));",
                            "const json = pm.response.json();",
                            "pm.collectionVariables.set('checklist_id', json.id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"title\": \"Задача для статистики\",\n    \"status\": \"pending\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/checklists",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        },
        {
            "name": "6. Завершить Чек-лист (KPI вырастет)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Чек-лист завершен', () => pm.response.to.have.status(200));",
                            "",
                            "// После этого шага можно повторно вызвать запрос №2",
                            "// completion_rate должен вырасти"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/checklists/{{checklist_id}}/complete",
                    "host": ["{{base_url}}"]
                }
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8080/api/v1"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "plan_id",
            "value": ""
        },
        {
            "key": "tenant_id",
            "value": ""
        },
        {
            "key": "checklist_id",
            "value": ""
        }
    ]
}