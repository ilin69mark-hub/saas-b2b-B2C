 {
    "info": {
        "_postman_id": "franchise-saas-franchiser-fix-v3",
        "name": "Франчайзер (Fix Applied)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "0. Настройка (Очистка и Создание)",
            "item": [
                {
                    "name": "Регистрация client@test.com",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус 201 (Создан)\", () => pm.response.to.have.status(201));",
                                    "",
                                    "var jsonData = pm.response.json();",
                                    "",
                                    "if (jsonData.token) {",
                                    "    pm.collectionVariables.set(\"token\", jsonData.token);",
                                    "    console.log(\"✅ Токен сохранен\");",
                                    "}",
                                    "",
                                    "if (jsonData.user && jsonData.user.tenant_id) {",
                                    "    pm.collectionVariables.set(\"tenant_id\", jsonData.user.tenant_id);",
                                    "    console.log(\"✅ Tenant ID сохранен: \" + jsonData.user.tenant_id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"client@test.com\",\n    \"password\": \"123456789\",\n    \"first_name\": \"Client\",\n    \"last_name\": \"Test\",\n    \"role\": \"franchiser\",\n    \"company_name\": \"Test Franchise Network\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/register",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "auth", "register"]
                        }
                    }
                }
            ]
        },
        {
            "name": "1. Авторизация",
            "item": [
                {
                    "name": "Вход (Логин)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус 200 (OK)\", () => pm.response.to.have.status(200));",
                                    "",
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.token) {",
                                    "    pm.collectionVariables.set(\"token\", jsonData.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"client@test.com\",\n    \"password\": \"123456789\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/login",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "auth", "login"]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Уведомления",
            "item": [
                {
                    "name": "Список уведомлений",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус 200 (OK)\", () => {",
                                    "    // Если падает с 400, значит в базе мусор. Нужно выполнить TRUNCATE TABLE notifications;",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Это массив\", () => {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.be.an('array');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" } ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/notifications",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "notifications"]
                        }
                    }
                },
                {
                    "name": "Прочитать все",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус 200 (OK)\", () => pm.response.to.have.status(200));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" } ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/notifications/read-all",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "notifications", "read-all"]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. Подписка и Оплата",
            "item": [
                {
                    "name": "Статус подписки (Инфо о Тенанте)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус 200 (OK)\", () => pm.response.to.have.status(200));",
                                    "",
                                    "pm.test(\"Есть дата окончания подписки\", () => {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('paid_until');",
                                    "    console.log(\"Оплачено до: \" + jsonData.paid_until);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" } ],
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/tenants/{{tenant_id}}",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "tenants", "{{tenant_id}}"]
                        }
                    }
                },
                {
                    "name": "Продлить подписку",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Статус 200 (OK)\", () => pm.response.to.have.status(200));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "header": [ { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" } ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"paid_until\": \"2026-12-31T23:59:59Z\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/admin/tenants/{{tenant_id}}",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "admin", "tenants", "{{tenant_id}}"]
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        { "key": "base_url", "value": "http://localhost:8080" },
        { "key": "token", "value": "" },
        { "key": "tenant_id", "value": "" }
    ]
}